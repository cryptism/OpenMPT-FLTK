#!/usr/bin/env bash
# Run this checkout's own build (from `cmake -B build`, inside `nix develop`) on native Wayland.
# Usage: local/openmpt-fltk [song.it]
# For the reproducible Nix build instead: nix run 'git+file://'"$PWD"'?submodules=1' -- [song.it]
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
exec nix develop "$here/.." -c "$here/../build/bin/OpenMPT" "$@"
